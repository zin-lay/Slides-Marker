# ─────────────────────────────────────────────────────────────
# Nexora Slide Maker — configuration
# Copy to .env and edit. The core tool works with NO settings:
# writing an outline and downloading .pptx needs nothing here.
# ─────────────────────────────────────────────────────────────

# Web server
HOST=127.0.0.1
PORT=3200

# Optional login
APP_USER=admin
APP_PASSWORD=

# ── Optional: AI outline drafting ────────────────────────────
# Leave PROVIDER=none to keep AI off (you write outlines yourself).
# Set to ollama | openai | anthropic to enable the “Draft with AI” box.
PROVIDER=none

# Ollama (local, no key)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# OpenAI-compatible (e.g. Groq: https://api.groq.com/openai/v1, model openai/gpt-oss-20b)
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=
OPENAI_MODEL=local-model

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Generation
MAX_OUTPUT_TOKENS=1500
TEMPERATURE=0.5

# PDF export (needs LibreOffice). Set its path if not on PATH:
# SOFFICE_BIN=soffice
MAX_UPLOAD_MB=25
